{
  "name": "dsh-conversations-archive",
  "version": "0.1.4",
  "description": "Append-only plain-text archive of DSH, QQ and Bilibili conversations, with a search tool for keyword and date lookup.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "cordis",
    "archive",
    "conversation",
    "memory",
    "search"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/decode.mjs",
    "lib/extract.mjs",
    "lib/platform.mjs",
    "lib/redact.mjs",
    "lib/store.mjs",
    "lib/search.mjs",
    "lib/backfill.mjs",
    "lib/windows.mjs",
    "lib/settings.mjs",
    "lib/media.mjs",
    "lib/privacy.mjs",
    "lib/enhance.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/axdfczbh/dsh-conversations-archive"
  },
  "homepage": "https://github.com/axdfczbh/dsh-conversations-archive#readme"
}
